# VitePress 的 vite root 是 docs/，env 文件要放在这一级，复制为 docs/.env.local 使用。

# 后端地址，不填则用生产环境 https://api-admin.atomeocean.com
VITE_API_BASE_URL=https://api-admin.atomeocean.com

# 本地开发用的 /auth/me mock，仅在 dev 下生效，生产构建会被摇掉。
# 可选值：anonymous（未登录）| member（只有 MEMBER）| internal（MEMBER + INTERNAL + WIKI）
# 留空则发真实请求。本地跨站 Cookie 发不出去，真实登录只能部署到正式域名后验证。
VITE_AUTH_MOCK=
